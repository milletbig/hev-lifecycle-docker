# 复制为 .env 后按需修改；口令请通过 scripts/deploy.sh 或 scripts/gen-password-hash.py 生成。
HEV_PORT=18480
HEV_BIND_ADDR=0.0.0.0
HEV_DATA_DIR=/home/shawn/hev-lifecycle/data

ADMIN_USERNAME=admin
# 格式：scrypt:16384:8:1:<salt>:<hash>（deploy.sh 自动写入）
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

SESSION_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=false
TRUST_PROXY=false

MAX_LOGIN_FAILURES=5
LOGIN_LOCK_MINUTES=10

MAX_STATE_BYTES=16777216
BACKUP_KEEP=30

TZ=Asia/Shanghai
